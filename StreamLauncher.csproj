<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>StreamLauncher</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Product>Stream Launcher</Product>
    <Company>TomLine prod&amp;co</Company>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="assets\LaunchStub.exe" LogicalName="LaunchStub.exe" />
    <EmbeddedResource Include="assets\chat-default.wav" LogicalName="chat-default.wav" />
    <EmbeddedResource Include="assets\platform-*.png" LogicalName="%(Filename)%(Extension)" />
    <Compile Remove="tools\**" />
  </ItemGroup>
</Project>
